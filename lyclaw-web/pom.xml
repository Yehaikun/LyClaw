<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lyjew.com</groupId>
        <artifactId>LyClaw</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lyclaw-web</artifactId>
    <packaging>jar</packaging>
    <name>LyClaw Web</name>
    <description>Web层：HTTP入口、请求路由、唯一部署单元（单体架构）</description>

    <dependencies>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-plan</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-action</artifactId>
        </dependency>
        <dependency>
            <groupId>lyjew.com</groupId>
            <artifactId>lyclaw-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
