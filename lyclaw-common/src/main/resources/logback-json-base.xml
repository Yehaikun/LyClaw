<?xml version="1.0" encoding="UTF-8"?>
<included>
    <!--
        Base logback configuration providing both JSON (production) and
        human-readable (development) console appenders.
        Activate JSON via: -Dspring.profiles.active=json or env LOGGING_FORMAT=json
    -->

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","logger":"%logger{36}","traceId":"%mdc{traceId}","spanId":"%mdc{spanId}","service":"%mdc{service}","message":"%msg"}%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%highlight(%level)] [%mdc{traceId:-no-trace}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="${LOGGING_APPENDER:-CONSOLE_PLAIN}" />
    </root>
</included>
